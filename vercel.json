{
  "installCommand": "pip install -r requirements.txt",
  "includeFiles": [
    "backend/**",
    "templates/**",
    "frontend/**",
    "ADVANCED_TEST_REPORT.md",
    "cms_v12.db"
  ],
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
